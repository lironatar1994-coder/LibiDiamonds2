{
  "version": 1,
  "catalogBackground": "#f5f2ec",
  "outputDirectory": "public/images/products/catalog",
  "defaultMasterRoot": "../LibiDiamondsAssets/masters",
  "outputSize": 1600,
  "maxOutputBytes": 340000,
  "minimumMasterSize": 2400,
  "alphaThreshold": 3,
  "edgePadding": 24,
  "occupancyTolerance": 0.045,
  "renderProfile": {
    "version": 3,
    "webpQualities": [96, 94, 92, 90, 88],
    "smartSubsample": false,
    "sharpen": {
      "primary": { "sigma": 0.62, "m1": 0.72, "m2": 1.35, "x1": 2, "y2": 9, "y3": 18 },
      "detail": { "sigma": 0.72, "m1": 0.82, "m2": 1.55, "x1": 2, "y2": 9, "y3": 18 }
    }
  },
  "occupancy": {
    "rings": 0.68,
    "earrings": 0.58,
    "necklaces": 0.82,
    "bracelets": 0.82,
    "detail": 0.84
  },
  "previewSurfaces": ["#f5f2ec", "#f7f6f2", "#ffffff"],
  "catalogShadows": {
    "rings": {
      "primary": { "blur": 20, "opacity": 0.14, "offsetY": 14, "rgb": [24, 27, 28] },
      "detail": { "blur": 16, "opacity": 0.11, "offsetY": 10, "rgb": [24, 27, 28] }
    },
    "earrings": {
      "primary": { "blur": 19, "opacity": 0.12, "offsetY": 12, "rgb": [24, 27, 28] },
      "detail": { "blur": 15, "opacity": 0.10, "offsetY": 9, "rgb": [24, 27, 28] }
    },
    "necklaces": {
      "primary": { "blur": 22, "opacity": 0.08, "offsetY": 11, "rgb": [24, 27, 28] },
      "detail": { "blur": 18, "opacity": 0.075, "offsetY": 8, "rgb": [24, 27, 28] }
    },
    "bracelets": {
      "primary": { "blur": 20, "opacity": 0.11, "offsetY": 12, "rgb": [24, 27, 28] },
      "detail": { "blur": 17, "opacity": 0.09, "offsetY": 9, "rgb": [24, 27, 28] }
    }
  }
}
